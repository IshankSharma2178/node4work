# SMTP (used by the BullMQ worker via nodemailer). Secure: true when SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nodebase <no-reply@nodebase.app>"
# Max OTP emails a single address may receive per rolling hour (sliding window)
RATE_LIMIT_OTP_PER_HOUR=5
# Optional basic-auth credentials for the BullMQ dashboard at /admin/queues
# When unset, the dashboard is only available in development.
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=